{
  "name": "plant-debugger",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "generate-svgs": "node scripts/generateAsciiSvgs.js",
    "update-ascii": "node scripts/updateAsciiFromConstants.js && npm run generate-svgs",
    "prepare": "simple-git-hooks"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "browser-image-compression": "^2.0.2",
    "html2canvas-pro": "^2.4.1",
    "jspdf": "^4.2.1",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "lint-staged": "^16.4.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run typecheck && npm test"
  }
}
